{
  "DataConfigs": {
    "serviceName": "rainmaker-studio",
    "version": "1.0.0",
    "baseKeyPath": "$.PublicService.*.Application.*",
    "entityIdPath": "$.id",
    "isCommonTableBorderRequired": true,
    "mappings": [
      {
        "mappings": [
          {
            "direct": [
              {
                "variable": "logoImage1",
                "type": "image",
                "url": "https://tfstate2pzyc.blob.core.windows.net/studio-demo-filestore/st/DigitStudio/October/20/1792476762595SAXfxhOIec.png?sig=g7Bx7b9VqahgC1MtchBv1sliwSLu%2F1K2Dj4PaUJEpM4%3D\u0026st=2026-10-20T06%3A13%3A14Z\u0026se=2026-10-21T06%3A13%3A14Z\u0026sv=2016-05-31\u0026sp=r\u0026sr=b"
              },
              {
                "variable": "applicationNumber",
                "value": {
                  "path": "$.applicationNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "serviceCode",
                "value": {
                  "path": "$.serviceCode"
                },
                "type": "setEmpty"
              },
              {
                "variable": "qrUUID",
                "value": {
                  "path": "$.qrUUID"
                },
                "type": "setEmpty"
              },
              {
                "variable": "status",
                "value": {
                  "path": "$.workflowStatus"
                },
                "type": "setEmpty",
                "localisation": {
                  "required": true,
                  "prefix": "PDF_PDF_CONFIGURATION_V1_STATE",
                  "module": "rainmaker-studio-pdf"
                }
              }
            ]
          },
          {
            "externalAPI": [
              {
                "path": "http://egov-workflow-v2.egov:8080/egov-workflow-v2/health",
                "queryParam": "tenantId={$.tenantId}",
                "requesttype": "GET",
                "apiRequest": null,
                "responseMapping": [
                  {
                    "variable": "serviceHealth",
                    "value": "$",
                    "localisation": {
                      "required": true,
                      "prefix": "STUDIO",
                      "module": "rainmaker-studio-pdf"
                    }
                  }
                ]
              }
            ]
          },
          {
            "qrcodeConfig": [
              {
                "variable": "qr_code_image",
                "value": "https://studio-demo.digit.org/digit-studio/citizen/publicservices/scan?pdf-id={{qrUUID}}"
              }
            ]
          }
        ]
      }
    ]
  },
  "key": "Configuration-PDF-pdf1"
}