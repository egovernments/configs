{
  "DataConfigs": {
    "serviceName": "rainmaker-studio",
    "version": "1.0.0",
    "baseKeyPath": "$.PublicService.*",
    "entityIdPath": "$.Application[0].id",
    "isCommonTableBorderRequired": true,
    "mappings": [
      {
        "mappings": [
          {
            "direct": [
              {
                "variable": "logoImage1",
                "type": "image",
                "url": "https://egovfilestoreunifieddev.blob.core.windows.net/unified-dev-filestore/dev/DigitStudio/September/18/1789702681503UfEUmzOBmv.png"
              },
              {
                "variable": "applicationNumber",
                "value": {
                  "path": "$.Application[0].applicationNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "transactionNumber",
                "value": {
                  "path": "$.Payments[0].transactionNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "transactionDate",
                "value": {
                  "path": "$.Payments[0].transactionDate"
                },
                "type": "date"
              },
              {
                "variable": "payerName",
                "value": {
                  "path": "$.Payments[0].payerName"
                },
                "type": "setEmpty"
              },
              {
                "variable": "totalAmountPaid",
                "value": {
                  "path": "$.Payments[0].totalAmountPaid"
                },
                "type": "setEmpty"
              },
              {
                "variable": "paymentMode",
                "value": {
                  "path": "$.Payments[0].paymentMode"
                },
                "type": "setEmpty",
                "localisation": {
                  "required": true,
                  "prefix": null,
                  "module": "rainmaker-studio-marvel"
                }
              },
              {
                "variable": "applicationStatus",
                "value": {
                  "path": "$.Application[0].workflowStatus"
                },
                "type": "setEmpty",
                "localisation": {
                  "required": true,
                  "prefix": null,
                  "module": "rainmaker-studio-marvel"
                }
              },
              {
                "variable": "serviceCode",
                "value": {
                  "path": "$.Application[0].serviceCode"
                },
                "type": "setEmpty"
              },
              {
                "variable": "qrUUID",
                "value": {
                  "path": "$.qrUUID"
                },
                "type": "setEmpty"
              }
            ]
          },
          {
            "externalAPI": [
              {
                "path": "http://egov-workflow-v2.egov:8080/egov-workflow-v2/health",
                "queryParam": "tenantId={$.tenantId}",
                "requesttype": "GET",
                "apiRequest": null,
                "responseMapping": [
                  {
                    "variable": "serviceHealth",
                    "value": "$",
                    "localisation": {
                      "required": true,
                      "prefix": "STUDIO",
                      "module": "rainmaker-studio-marvel"
                    }
                  }
                ]
              }
            ]
          },
          {
            "qrcodeConfig": [
              {
                "variable": "qr_code_image",
                "value": "https://unified-dev.digit.org/digit-studio/citizen/publicservices/scan?pdf-id={{qrUUID}}"
              }
            ]
          }
        ]
      }
    ]
  },
  "key": "series-Marvel-pdf3"
}