{
  "DataConfigs": {
    "serviceName": "rainmaker-studio",
    "version": "1.0.0",
    "baseKeyPath": "$.PublicService.*.Application.*",
    "entityIdPath": "$.id",
    "isCommonTableBorderRequired": true,
    "mappings": [
      {
        "mappings": [
          {
            "direct": [
              {
                "variable": "logoImage1",
                "type": "image",
                "url": "https://unified-dev-bucket-s3.s3.ap-south-1.amazonaws.com/dev/DigitStudio/July/29/1785315019496iFqderqDWq.png"
              },
              {
                "variable": "applicationNumber",
                "value": {
                  "path": "$.applicationNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "applicationStatus",
                "value": {
                  "path": "$.status"
                },
                "type": "setEmpty",
                "localisation": {
                  "module": "rainmaker-studio-exist",
                  "prefix": "EXIST_EXIST_INFO_V1_STATE",
                  "required": true
                }
              },
              {
                "variable": "applicationDate",
                "value": {
                  "path": "$.auditDetails.createdTime"
                },
                "type": "date"
              },
              {
                "variable": "name",
                "value": {
                  "path": "$.applicants[0].name"
                },
                "type": "setEmpty",
                "localisation": {
                  "module": "rainmaker-studio-exist",
                  "prefix": null,
                  "required": true
                }
              },
              {
                "variable": "mobileNumber",
                "value": {
                  "path": "$.applicants[0].mobileNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "email",
                "value": {
                  "path": "$.applicants[0].emailId"
                },
                "type": "setEmpty"
              },
              {
                "variable": "gender",
                "value": {
                  "path": "$.applicants[0].gender"
                },
                "type": "setEmpty"
              },
              {
                "variable": "serviceCode",
                "value": {
                  "path": "$.serviceCode"
                },
                "type": "setEmpty"
              }
            ]
          },
          {
            "externalAPI": [
              {
                "path": "http://egov-workflow-v2.egov:8080/egov-workflow-v2/health",
                "queryParam": "tenantId={$.tenantId}",
                "requesttype": "GET",
                "apiRequest": null,
                "responseMapping": [
                  {
                    "variable": "serviceHealth",
                    "value": "$",
                    "localisation": {
                      "required": true,
                      "prefix": "STUDIO",
                      "module": "rainmaker-studio-exist"
                    }
                  }
                ]
              }
            ]
          },
          {
            "qrcodeConfig": [
              {
                "variable": "qr_code_image",
                "value": "https://unified-dev.digit.org/digit-studio/employee/publicservices/Exist/Info/ViewScreen?applicationNumber={{applicationNumber}}\u0026serviceCode={{serviceCode}}"
              }
            ]
          }
        ]
      }
    ]
  },
  "key": "configure-Theme-pdf2"
}