{
  "DataConfigs": {
    "serviceName": "rainmaker-studio",
    "version": "1.0.0",
    "baseKeyPath": "$.PublicService.*.Application.*",
    "entityIdPath": "$.id",
    "isCommonTableBorderRequired": true,
    "mappings": [
      {
        "mappings": [
          {
            "direct": [
              {
                "variable": "logoImage1",
                "type": "image",
                "url": "https://egovfilestoreunifieddev.blob.core.windows.net/unified-dev-filestore/dev/DigitStudio/September/25/1790333933127wOGrQQYxYA.png?sig=SdXtE8ubUcS7DQD2pOcuNAXUtWShJu6PchMc0q6yzOY%3D\u0026st=2026-09-25T10%3A59%3A05Z\u0026se=2026-09-26T10%3A59%3A05Z\u0026sv=2016-05-31\u0026sp=r\u0026sr=b"
              },
              {
                "variable": "applicationNumber",
                "value": {
                  "path": "$.applicationNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "serviceCode",
                "value": {
                  "path": "$.serviceCode"
                },
                "type": "setEmpty"
              },
              {
                "variable": "qrUUID",
                "value": {
                  "path": "$.qrUUID"
                },
                "type": "setEmpty"
              },
              {
                "variable": "status",
                "value": {
                  "path": "$.workflowStatus"
                },
                "type": "setEmpty",
                "localisation": {
                  "required": true,
                  "prefix": "LOOK_LOOK_TEST_V1_STATE",
                  "module": "rainmaker-studio-look"
                }
              }
            ]
          },
          {
            "externalAPI": [
              {
                "path": "http://egov-workflow-v2.egov:8080/egov-workflow-v2/health",
                "queryParam": "tenantId={$.tenantId}",
                "requesttype": "GET",
                "apiRequest": null,
                "responseMapping": [
                  {
                    "variable": "serviceHealth",
                    "value": "$",
                    "localisation": {
                      "required": true,
                      "prefix": "STUDIO",
                      "module": "rainmaker-studio-look"
                    }
                  }
                ]
              }
            ]
          },
          {
            "qrcodeConfig": [
              {
                "variable": "qr_code_image",
                "value": "https://unified-dev.digit.org/digit-studio/citizen/publicservices/scan?pdf-id={{qrUUID}}"
              }
            ]
          }
        ]
      }
    ]
  },
  "key": "Test-Look-pdf1"
}