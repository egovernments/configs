{
  "DataConfigs": {
    "serviceName": "rainmaker-studio",
    "version": "1.0.0",
    "baseKeyPath": "$.PublicService.*",
    "entityIdPath": "$.Application[0].id",
    "isCommonTableBorderRequired": true,
    "mappings": [
      {
        "mappings": [
          {
            "direct": [
              {
                "variable": "logoImage1",
                "type": "image",
                "url": "https://unified-dev-bucket-s3.s3.ap-south-1.amazonaws.com/dev/DigitStudio/July/28/1785244716462VOmdWQFcKW.png"
              },
              {
                "variable": "applicationNumber",
                "value": {
                  "path": "$.Application[0].applicationNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "applicationStatus",
                "value": {
                  "path": "$.Application[0].status"
                },
                "type": "setEmpty",
                "localisation": {
                  "required": true,
                  "prefix": null,
                  "module": "rainmaker-studio-theme"
                }
              },
              {
                "variable": "applicationDate",
                "value": {
                  "path": "$.Application[0].auditDetails.createdTime"
                },
                "type": "date"
              },
              {
                "variable": "consumerCode",
                "value": {
                  "path": "$.Bill[0].consumerCode"
                },
                "type": "setEmpty"
              },
              {
                "variable": "totalAmount",
                "value": {
                  "path": "$.Bill[0].totalAmount"
                },
                "type": "setEmpty"
              },
              {
                "variable": "payerName",
                "value": {
                  "path": "$.Bill[0].payerName"
                },
                "type": "setEmpty"
              },
              {
                "variable": "status",
                "value": {
                  "path": "$.Bill[0].status"
                },
                "type": "setEmpty",
                "localisation": {
                  "required": true,
                  "prefix": null,
                  "module": "rainmaker-studio-theme"
                }
              },
              {
                "variable": "serviceCode",
                "value": {
                  "path": "$.Application[0].serviceCode"
                },
                "type": "setEmpty"
              }
            ]
          },
          {
            "externalAPI": [
              {
                "path": "http://egov-workflow-v2.egov:8080/egov-workflow-v2/health",
                "queryParam": "tenantId={$.tenantId}",
                "requesttype": "GET",
                "apiRequest": null,
                "responseMapping": [
                  {
                    "variable": "serviceHealth",
                    "value": "$",
                    "localisation": {
                      "required": true,
                      "prefix": "STUDIO",
                      "module": "rainmaker-studio-theme"
                    }
                  }
                ]
              }
            ]
          },
          {
            "qrcodeConfig": [
              {
                "variable": "qr_code_image",
                "value": "https://unified-dev.digit.org/digit-studio/employee/publicservices/Theme/configure/ViewScreen?applicationNumber={{applicationNumber}}\u0026serviceCode={{serviceCode}}"
              }
            ]
          }
        ]
      }
    ]
  },
  "key": "configure-Theme-pdf4"
}