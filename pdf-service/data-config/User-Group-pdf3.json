{
  "DataConfigs": {
    "serviceName": "rainmaker-studio",
    "version": "1.0.0",
    "baseKeyPath": "$.PublicService.*",
    "entityIdPath": "$.Application[0].id",
    "isCommonTableBorderRequired": true,
    "mappings": [
      {
        "mappings": [
          {
            "direct": [
              {
                "variable": "logoImage1",
                "type": "image",
                "url": "https://unified-dev-bucket-s3.s3.ap-south-1.amazonaws.com/dev/DigitStudio/July/23/1784784490217wvzvfqoOOr.png"
              },
              {
                "variable": "applicationNumber",
                "value": {
                  "path": "$.Application[0].applicationNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "applicationStatus",
                "value": {
                  "path": "$.Application[0].status"
                },
                "type": "setEmpty",
                "localisation": {
                  "required": true,
                  "prefix": null,
                  "module": "rainmaker-studio"
                }
              },
              {
                "variable": "currentState",
                "value": {
                  "path": "$.Application[0].workflowStatus"
                },
                "type": "setEmpty",
                "localisation": {
                  "required": true,
                  "prefix": null,
                  "module": "rainmaker-studio"
                }
              },
              {
                "variable": "applicationDate",
                "value": {
                  "path": "$.Application[0].auditDetails.createdTime"
                },
                "type": "date"
              },
              {
                "variable": "receiptNumber",
                "value": {
                  "path": "$.Payments[0].paymentDetails[0].receiptNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "transactionNumber",
                "value": {
                  "path": "$.Payments[0].transactionNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "amountPaid",
                "value": {
                  "path": "$.Payments[0].totalAmountPaid"
                },
                "type": "setEmpty"
              },
              {
                "variable": "paymentMode",
                "value": {
                  "path": "$.Payments[0].paymentMode"
                },
                "type": "setEmpty",
                "localisation": {
                  "required": true,
                  "prefix": null,
                  "module": "rainmaker-studio"
                }
              },
              {
                "variable": "receiptDate",
                "value": {
                  "path": "$.Payments[0].paymentDetails[0].receiptDate"
                },
                "type": "date"
              },
              {
                "variable": "consumerCode",
                "value": {
                  "path": "$.Payments[0].paymentDetails[0].bill.consumerCode"
                },
                "type": "setEmpty"
              },
              {
                "variable": "qrUUID",
                "value": {
                  "path": "$.qrUUID"
                },
                "type": "setEmpty"
              }
            ]
          },
          {
            "externalAPI": [
              {
                "path": "http://egov-workflow-v2.egov:8080/egov-workflow-v2/health",
                "queryParam": "tenantId={$.tenantId}",
                "requesttype": "GET",
                "apiRequest": null,
                "responseMapping": [
                  {
                    "variable": "serviceHealth",
                    "value": "$",
                    "localisation": {
                      "required": true,
                      "prefix": "STUDIO",
                      "module": "rainmaker-studio"
                    }
                  }
                ]
              }
            ]
          },
          {
            "qrcodeConfig": [
              {
                "variable": "qr_code_image",
                "value": "https://unified-dev.digit.org/studio-pdf-helper-service/_scanQR?pdf-id={{qrUUID}}"
              }
            ]
          }
        ]
      }
    ]
  },
  "key": "User-Group-pdf3"
}