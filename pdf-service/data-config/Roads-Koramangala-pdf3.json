{
  "DataConfigs": {
    "serviceName": "rainmaker-studio",
    "version": "1.0.0",
    "baseKeyPath": "$.PublicService.*",
    "entityIdPath": "$.Application[0].id",
    "isCommonTableBorderRequired": true,
    "mappings": [
      {
        "mappings": [
          {
            "direct": [
              {
                "variable": "backgroundImage1",
                "type": "image",
                "url": "https://unified-dev-bucket-s3.s3.ap-south-1.amazonaws.com/dev/DigitStudio/July/31/1785495020169ggVmEEJtEz.jpeg"
              },
              {
                "variable": "applicationNumber",
                "value": {
                  "path": "$.Application[0].applicationNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "applicationStatus",
                "value": {
                  "path": "$.Application[0].status"
                },
                "type": "setEmpty",
                "localisation": {
                  "required": true,
                  "prefix": "KORAMANGALA_KORAMANGALA_ROADS_V1_STATE",
                  "module": "rainmaker-studio-koramangala"
                }
              },
              {
                "variable": "applicationDate",
                "value": {
                  "path": "$.Application[0].auditDetails.createdTime"
                },
                "type": "date"
              },
              {
                "variable": "serviceCode",
                "value": {
                  "path": "$.Application[0].serviceCode"
                },
                "type": "setEmpty"
              }
            ]
          },
          {
            "externalAPI": [
              {
                "path": "http://egov-workflow-v2.egov:8080/egov-workflow-v2/health",
                "queryParam": "tenantId={$.tenantId}",
                "requesttype": "GET",
                "apiRequest": null,
                "responseMapping": [
                  {
                    "variable": "serviceHealth",
                    "value": "$",
                    "localisation": {
                      "required": true,
                      "prefix": "STUDIO",
                      "module": "rainmaker-studio-koramangala"
                    }
                  }
                ]
              }
            ]
          },
          {
            "qrcodeConfig": [
              {
                "variable": "qr_code_image",
                "value": "http://localhost:3000/digit-studio/citizen/publicservices/scan?pdf-id={{pdf-id}}"
              }
            ]
          }
        ]
      }
    ]
  },
  "key": "Roads-Koramangala-pdf3"
}