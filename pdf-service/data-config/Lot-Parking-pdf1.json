{
  "DataConfigs": {
    "serviceName": "rainmaker-studio",
    "version": "1.0.0",
    "baseKeyPath": "$.PublicService.*.Application.*",
    "entityIdPath": "$.id",
    "isCommonTableBorderRequired": true,
    "mappings": [
      {
        "mappings": [
          {
            "direct": [
              {
                "variable": "logoImage1",
                "type": "image",
                "url": "https://egovfilestoreunifieduat.blob.core.windows.net/unified-uat-filestore/st/DigitStudio/October/9/1791538944019kJvcmscFEH.png?sig=uT9WiTDAwzrQDPyv4vEibaw32xF6FG8ZVbf69U2yGH4%3D\u0026st=2026-10-09T09%3A42%3A30Z\u0026se=2026-10-10T09%3A42%3A30Z\u0026sv=2016-05-31\u0026sp=r\u0026sr=b"
              },
              {
                "variable": "applicationNumber",
                "value": {
                  "path": "$.applicationNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "serviceCode",
                "value": {
                  "path": "$.serviceCode"
                },
                "type": "setEmpty"
              },
              {
                "variable": "qrUUID",
                "value": {
                  "path": "$.qrUUID"
                },
                "type": "setEmpty"
              },
              {
                "variable": "status",
                "value": {
                  "path": "$.workflowStatus"
                },
                "type": "setEmpty",
                "localisation": {
                  "required": true,
                  "prefix": "PARKING_PARKING_LOT_V1_STATE",
                  "module": "rainmaker-studio-parking"
                }
              }
            ]
          },
          {
            "externalAPI": [
              {
                "path": "http://egov-workflow-v2.egov:8080/egov-workflow-v2/health",
                "queryParam": "tenantId={$.tenantId}",
                "requesttype": "GET",
                "apiRequest": null,
                "responseMapping": [
                  {
                    "variable": "serviceHealth",
                    "value": "$",
                    "localisation": {
                      "required": true,
                      "prefix": "STUDIO",
                      "module": "rainmaker-studio-parking"
                    }
                  }
                ]
              }
            ]
          },
          {
            "qrcodeConfig": [
              {
                "variable": "qr_code_image",
                "value": "https://unified-uat.digit.org/digit-studio/citizen/publicservices/scan?pdf-id={{qrUUID}}"
              }
            ]
          }
        ]
      }
    ]
  },
  "key": "Lot-Parking-pdf1"
}