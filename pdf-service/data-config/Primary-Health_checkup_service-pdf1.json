                "responseMapping": [
                  {
                    "variable": "serviceHealth",
                    "value": "$",
                    "localisation": {
                      "required": true,
                      "prefix": "STUDIO",
                      "module": "rainmaker-studio-health_checkup_service"
                    }
                  }
                ]
              }
            ]
          },
          {
            "qrcodeConfig": [
              {
                "variable": "qr_code_image",
