              },
              {
                "variable": "applicationNumber",
                "value": {
                  "path": "$.applicationNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "name",
                "value": {
                  "path": "$.applicants[0].name"
                },
                "type": "setEmpty",
                "localisation": {
                  "required": true,
                  "prefix": null,
                  "module": "rainmaker-studio-health_checkup_service"
                }
              },
              {
                "variable": "serviceCode",
                "value": {
                  "path": "$.serviceCode"
                },
                "type": "setEmpty"
              },
              {
                "variable": "qrUUID",
                "value": {
                  "path": "$.qrUUID"
                },
                "type": "setEmpty"
              }
            ]
          },
          {
            "externalAPI": [
