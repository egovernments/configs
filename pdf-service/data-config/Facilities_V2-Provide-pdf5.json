{
  "DataConfigs": {
    "serviceName": "rainmaker-studio",
    "version": "1.0.0",
    "baseKeyPath": "$.PublicService.*",
    "entityIdPath": "$.Application[0].id",
    "isCommonTableBorderRequired": true,
    "mappings": [
      {
        "mappings": [
          {
            "direct": [
              {
                "variable": "logoImage1",
                "type": "image",
                "url": "https://unified-dev-bucket-s3.s3.ap-south-1.amazonaws.com/dev/DigitStudio/August/4/1785826502811DTOkapzZdU.jpeg"
              },
              {
                "variable": "applicationNumber",
                "value": {
                  "path": "$.applicationNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "billNumber",
                "value": {
                  "path": "$.Bill[0].billNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "billDate",
                "value": {
                  "path": "$.Bill[0].billDate"
                },
                "type": "date"
              },
              {
                "variable": "payerName",
                "value": {
                  "path": "$.Bill[0].payerName"
                },
                "type": "setEmpty"
              },
              {
                "variable": "totalAmount",
                "value": {
                  "path": "$.Bill[0].totalAmount"
                },
                "type": "setEmpty"
              },
              {
                "variable": "expiryDate",
                "value": {
                  "path": "$.Bill[0].billDetails[0].expiryDate"
                },
                "type": "date"
              },
              {
                "variable": "serviceCode",
                "value": {
                  "path": "$.Application[0].serviceCode"
                },
                "type": "setEmpty"
              },
              {
                "variable": "billStatus",
                "value": {
                  "path": "$.Bill[0].status"
                },
                "type": "setEmpty",
                "localisation": {
                  "required": true,
                  "prefix": null,
                  "module": "rainmaker-studio-provide"
                }
              }
            ]
          },
          {
            "externalAPI": [
              {
                "path": "http://egov-workflow-v2.egov:8080/egov-workflow-v2/health",
                "queryParam": "tenantId={$.tenantId}",
                "requesttype": "GET",
                "apiRequest": null,
                "responseMapping": [
                  {
                    "variable": "serviceHealth",
                    "value": "$",
                    "localisation": {
                      "required": true,
                      "prefix": "STUDIO",
                      "module": "rainmaker-studio-provide"
                    }
                  }
                ]
              }
            ]
          },
          {
            "qrcodeConfig": [
              {
                "variable": "qr_code_image",
                "value": "http://localhost:3000/digit-studio/citizen/publicservices/scan?pdf-id={{qrUUID}}"
              }
            ]
          }
        ]
      }
    ]
  },
  "key": "Facilities_V2-Provide-pdf5"
}