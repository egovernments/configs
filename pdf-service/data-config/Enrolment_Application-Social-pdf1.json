{
  "DataConfigs": {
    "serviceName": "rainmaker-studio",
    "version": "1.0.0",
    "baseKeyPath": "$.PublicService.*.Application.*",
    "entityIdPath": "$.id",
    "isCommonTableBorderRequired": true,
    "mappings": [
      {
        "mappings": [
          {
            "direct": [
              {
                "variable": "applicationNumber",
                "value": {
                  "path": "$.applicationNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "beneficiaryName",
                "value": {
                  "path": "$.applicants[0].name"
                },
                "type": "setEmpty"
              },
              {
                "variable": "programme",
                "value": {
                  "path": "$.serviceDetails.Programmeandcategory.Programme"
                },
                "type": "setEmpty"
              },
              {
                "variable": "categoryPssb",
                "value": {
                  "path": "$.serviceDetails.Programmeandcategory.PSSBcategory"
                },
                "type": "setEmpty"
              },
              {
                "variable": "categoryPasd",
                "value": {
                  "path": "$.serviceDetails.Programmeandcategory.PASDcategory"
                },
                "type": "setEmpty"
              },
              {
                "variable": "categoryPasp",
                "value": {
                  "path": "$.serviceDetails.Programmeandcategory.PASPcategory"
                },
                "type": "setEmpty"
              },
              {
                "variable": "submittedOn",
                "value": {
                  "path": "$.auditDetails.createdTime"
                },
                "type": "date"
              },
              {
                "variable": "serviceCode",
                "value": {
                  "path": "$.serviceCode"
                },
                "type": "setEmpty"
              },
              {
                "variable": "qrUUID",
                "value": {
                  "path": "$.qrUUID"
                },
                "type": "setEmpty"
              },
              {
                "variable": "status",
                "value": {
                  "path": "$.workflowStatus"
                },
                "type": "setEmpty",
                "localisation": {
                  "required": true,
                  "prefix": "SOCIAL_SOCIAL_ENROLMENT_APPLICATION_V1_STATE",
                  "module": "rainmaker-studio-social"
                }
              }
            ]
          },
          {
            "externalAPI": [
              {
                "path": "http://egov-workflow-v2.egov:8080/egov-workflow-v2/health",
                "queryParam": "tenantId={$.tenantId}",
                "requesttype": "GET",
                "apiRequest": null,
                "responseMapping": [
                  {
                    "variable": "serviceHealth",
                    "value": "$",
                    "localisation": {
                      "required": true,
                      "prefix": "STUDIO",
                      "module": "rainmaker-studio-social"
                    }
                  }
                ]
              }
            ]
          },
          {
            "qrcodeConfig": [
              {
                "variable": "qr_code_image",
                "value": "https://studio-demo.digit.org/digit-studio/citizen/publicservices/scan?pdf-id={{qrUUID}}"
              }
            ]
          }
        ]
      }
    ]
  },
  "key": "Enrolment_Application-Social-pdf1"
}