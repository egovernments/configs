{
  "DataConfigs": {
    "serviceName": "rainmaker-studio",
    "version": "1.0.0",
    "baseKeyPath": "$.PublicService.*.Application.*",
    "entityIdPath": "$.id",
    "isCommonTableBorderRequired": true,
    "mappings": [
      {
        "mappings": [
          {
            "direct": [
              {
                "variable": "logoImage1",
                "type": "image",
                "url": "blob:https://unified-dev.digit.org/e62b6956-faba-443e-b634-e03a635e3316"
              },
              {
                "variable": "applicationNumber",
                "value": {
                  "path": "$.applicationNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "name",
                "value": {
                  "path": "$.applicants[0].name"
                },
                "type": "setEmpty",
                "localisation": {
                  "required": true,
                  "prefix": null,
                  "module": "rainmaker-studio-public"
                }
              },
              {
                "variable": "mobileNumber",
                "value": {
                  "path": "$.applicants[0].mobileNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "email",
                "value": {
                  "path": "$.applicants[0].emailId"
                },
                "type": "setEmpty"
              },
              {
                "variable": "gender",
                "value": {
                  "path": "$.applicants[0].gender"
                },
                "type": "setEmpty"
              },
              {
                "variable": "applicationStatus",
                "value": {
                  "path": "$.workflowStatus"
                },
                "type": "setEmpty",
                "localisation": {
                  "required": true,
                  "prefix": "PUBLIC_PUBLIC_LAUNCH_V1_STATE",
                  "module": "rainmaker-studio-public"
                }
              },
              {
                "variable": "submissionDate",
                "value": {
                  "path": "$.auditDetails.createdTime"
                },
                "type": "date"
              },
              {
                "variable": "submissionTime",
                "value": {
                  "path": "$.auditDetails.createdTime"
                },
                "type": "date"
              },
              {
                "variable": "serviceCode",
                "value": {
                  "path": "$.serviceCode"
                },
                "type": "setEmpty"
              },
              {
                "variable": "qrUUID",
                "value": {
                  "path": "$.qrUUID"
                },
                "type": "setEmpty"
              }
            ]
          },
          {
            "externalAPI": [
              {
                "path": "http://egov-workflow-v2.egov:8080/egov-workflow-v2/health",
                "queryParam": "tenantId={$.tenantId}",
                "requesttype": "GET",
                "apiRequest": null,
                "responseMapping": [
                  {
                    "variable": "serviceHealth",
                    "value": "$",
                    "localisation": {
                      "required": true,
                      "prefix": "STUDIO",
                      "module": "rainmaker-studio-public"
                    }
                  }
                ]
              }
            ]
          },
          {
            "qrcodeConfig": [
              {
                "variable": "qr_code_image",
                "value": "https://unified-dev.digit.org/digit-studio/citizen/publicservices/scan?pdf-id={{qrUUID}}"
              }
            ]
          }
        ]
      }
    ]
  },
  "key": "Launch-Public-pdf1"
}