{
  "DataConfigs": {
    "serviceName": "rainmaker-studio",
    "version": "1.0.0",
    "baseKeyPath": "$.PublicService.*.Application.*",
    "entityIdPath": "$.id",
    "isCommonTableBorderRequired": true,
    "mappings": [
      {
        "mappings": [
          {
            "direct": [
              {
                "variable": "logoImage1",
                "type": "image",
                "url": "https://unified-dev-bucket-s3.s3.ap-south-1.amazonaws.com/dev/DigitStudio/July/29/1785317264743MtTBWWqlXS.png"
              },
              {
                "variable": "applicationNumber",
                "value": {
                  "path": "$.applicationNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "applicationDate",
                "value": {
                  "path": "$.auditDetails.createdTime"
                },
                "type": "date"
              },
              {
                "variable": "name",
                "value": {
                  "path": "$.applicants[0].name"
                },
                "type": "setEmpty",
                "localisation": {
                  "required": true,
                  "prefix": null,
                  "module": "rainmaker-studio-business_license"
                }
              },
              {
                "variable": "businessName",
                "value": {
                  "path": "$.serviceDetails.BusinessDetails.Businessname"
                },
                "type": "setEmpty"
              },
              {
                "variable": "serviceCode",
                "value": {
                  "path": "$.serviceCode"
                },
                "type": "setEmpty"
              }
            ]
          },
          {
            "externalAPI": [
              {
                "path": "http://egov-workflow-v2.egov:8080/egov-workflow-v2/health",
                "queryParam": "tenantId={$.tenantId}",
                "requesttype": "GET",
                "apiRequest": null,
                "responseMapping": [
                  {
                    "variable": "serviceHealth",
                    "value": "$",
                    "localisation": {
                      "required": true,
                      "prefix": "STUDIO",
                      "module": "rainmaker-studio-business_license"
                    }
                  }
                ]
              }
            ]
          },
          {
            "qrcodeConfig": [
              {
                "variable": "qr_code_image",
                "value": "https://unified-dev.digit.org/digit-studio/employee/publicservices/Business_License/Issuance/ViewScreen?applicationNumber={{applicationNumber}}\u0026serviceCode={{serviceCode}}"
              }
            ]
          }
        ]
      }
    ]
  },
  "key": "Issuance-Business_License-pdf2"
}