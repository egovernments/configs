{
  "DataConfigs": {
    "serviceName": "rainmaker-studio",
    "version": "1.0.0",
    "baseKeyPath": "$.PublicService.*.Application.*",
    "entityIdPath": "$.id",
    "isCommonTableBorderRequired": true,
    "mappings": [
      {
        "mappings": [
          {
            "direct": [
              {
                "variable": "logoImage1",
                "type": "image",
                "url": "https://egovfilestoreunifiedqa.blob.core.windows.net/unified-qa-filestore/la/DigitStudio/October/19/1792405712411BGnBpsyKZl.png?sig=VdbgcNEgy8DFoWeaPk4U%2BO%2FYXhzDggt6vlSc9Clrsf8%3D\u0026st=2026-10-19T10%3A28%3A56Z\u0026se=2026-10-20T10%3A28%3A56Z\u0026sv=2016-05-31\u0026sp=r\u0026sr=b"
              },
              {
                "variable": "applicationNumber",
                "value": {
                  "path": "$.applicationNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "serviceCode",
                "value": {
                  "path": "$.serviceCode"
                },
                "type": "setEmpty"
              },
              {
                "variable": "qrUUID",
                "value": {
                  "path": "$.qrUUID"
                },
                "type": "setEmpty"
              },
              {
                "variable": "status",
                "value": {
                  "path": "$.workflowStatus"
                },
                "type": "setEmpty",
                "localisation": {
                  "required": true,
                  "prefix": "MATERIAL_MATERIAL_WORK_V1_STATE",
                  "module": "rainmaker-studio-material"
                }
              }
            ]
          },
          {
            "externalAPI": [
              {
                "path": "http://egov-workflow-v2.egov:8080/egov-workflow-v2/health",
                "queryParam": "tenantId={$.tenantId}",
                "requesttype": "GET",
                "apiRequest": null,
                "responseMapping": [
                  {
                    "variable": "serviceHealth",
                    "value": "$",
                    "localisation": {
                      "required": true,
                      "prefix": "STUDIO",
                      "module": "rainmaker-studio-material"
                    }
                  }
                ]
              }
            ]
          },
          {
            "qrcodeConfig": [
              {
                "variable": "qr_code_image",
                "value": "https://unified-qa.digit.org/digit-studio/citizen/publicservices/scan?pdf-id={{qrUUID}}"
              }
            ]
          }
        ]
      }
    ]
  },
  "key": "work-Material-pdf1"
}