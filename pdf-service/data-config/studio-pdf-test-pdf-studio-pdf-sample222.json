{
  "DataConfigs": {
    "serviceName": "rainmaker-studio",
    "version": "1.0.0",
    "baseKeyPath": "$.PublicService.*.Application.*",
    "entityIdPath": "$.id",
    "isCommonTableBorderRequired": true,
    "mappings": [
      {
        "mappings": [
          {
            "direct": [
              {
                "variable": "applicationNumber",
                "value": {
                  "path": "$.applicationNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "applicantName",
                "value": {
                  "path": "$.applicants[0].name"
                },
                "type": "setEmpty"
              },
              {
                "variable": "applicantMobile",
                "value": {
                  "path": "$.applicants[0].mobileNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "workflowStatus",
                "value": {
                  "path": "$.workflowStatus"
                },
                "type": "setEmpty"
              },
              {
                "variable": "applicationDate",
                "value": {
                  "path": "$.auditDetails.createdTime"
                },
                "type": "date"
              }
            ]
          },
          {
            "qrcodeConfig": [
              {
                "variable": "qr_code_image",
                "value": "https://unified-dev.digit.org/studio-pdf-helper-service/_scanQR?pdf-id="
              }
            ]
          }
        ]
      }
    ]
  },
  "key": "studio-pdf-test-pdf-studio-pdf-sample222"
}