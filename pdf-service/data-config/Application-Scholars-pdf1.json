{
  "DataConfigs": {
    "serviceName": "rainmaker-studio",
    "version": "1.0.0",
    "baseKeyPath": "$.PublicService.*.Application.*",
    "entityIdPath": "$.id",
    "isCommonTableBorderRequired": true,
    "mappings": [
      {
        "mappings": [
          {
            "direct": [
              {
                "variable": "applicationNumber",
                "value": {
                  "path": "$.applicationNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "applicationDate",
                "value": {
                  "path": "$.auditDetails.createdTime"
                },
                "type": "date"
              },
              {
                "variable": "status",
                "value": {
                  "path": "$.workflowStatus"
                },
                "type": "setEmpty",
                "localisation": {
                  "module": "rainmaker-studio-scholars",
                  "prefix": "SCHOLARS_SCHOLARS_APPLICATION_V1_STATE",
                  "required": true
                }
              },
              {
                "variable": "studentName",
                "value": {
                  "path": "$.serviceDetails.StudentInformation.Studentfullname"
                },
                "type": "setEmpty"
              },
              {
                "variable": "applicantType",
                "value": {
                  "path": "$.serviceDetails.StudentInformation.Applicanttype"
                },
                "type": "setEmpty"
              },
              {
                "variable": "programme",
                "value": {
                  "path": "$.serviceDetails.ScholarshipandEducationDetails.Scholarshipprogramme"
                },
                "type": "setEmpty"
              },
              {
                "variable": "academicYear",
                "value": {
                  "path": "$.serviceDetails.ScholarshipandEducationDetails.Academicyear"
                },
                "type": "setEmpty"
              },
              {
                "variable": "studyLevel",
                "value": {
                  "path": "$.serviceDetails.ScholarshipandEducationDetails.Studylevel"
                },
                "type": "setEmpty"
              },
              {
                "variable": "course",
                "value": {
                  "path": "$.serviceDetails.ScholarshipandEducationDetails.Courseorfieldofstudy"
                },
                "type": "setEmpty"
              },
              {
                "variable": "serviceCode",
                "value": {
                  "path": "$.serviceCode"
                },
                "type": "setEmpty"
              },
              {
                "variable": "qrUUID",
                "value": {
                  "path": "$.qrUUID"
                },
                "type": "setEmpty"
              }
            ]
          },
          {
            "externalAPI": [
              {
                "path": "http://egov-workflow-v2.egov:8080/egov-workflow-v2/health",
                "queryParam": "tenantId={$.tenantId}",
                "requesttype": "GET",
                "apiRequest": null,
                "responseMapping": [
                  {
                    "variable": "serviceHealth",
                    "value": "$",
                    "localisation": {
                      "required": true,
                      "prefix": "STUDIO",
                      "module": "rainmaker-studio-scholars"
                    }
                  }
                ]
              }
            ]
          },
          {
            "qrcodeConfig": [
              {
                "variable": "qr_code_image",
                "value": "https://studio-demo.digit.org/digit-studio/citizen/publicservices/scan?pdf-id={{qrUUID}}"
              }
            ]
          }
        ]
      }
    ]
  },
  "key": "Application-Scholars-pdf1"
}