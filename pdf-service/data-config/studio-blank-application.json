{
  "key": "studio-blank-application",
  "documentType": "PUBLICSERVICE",
  "DataConfigs": {
    "serviceName": "public-services",
    "version": "1.0.0",
    "baseKeyPath": "$.PublicService.*",
    "entityIdPath": "$.Application[0].applicationNumber",
    "mappings": [
      {
        "mappings": [
          {
            "direct": [
              {
                "variable": "APPLICATION_NUMBER",
                "value": { "path": "$.Application[0].applicationNumber" }
              },
              {
                "variable": "SERVICE_CODE",
                "value": { "path": "$.Application[0].serviceCode" }
              },
              {
                "variable": "WORKFLOW_STATUS",
                "value": { "path": "$.Application[0].workflowStatus" }
              },
              {
                "variable": "CREATED_DATE",
                "value": { "path": "$.Application[0].auditDetails.createdTime" }
              },
              {
                "variable": "APPLICANT_NAME",
                "value": { "path": "$.Application[0].applicants[0].name" }
              },
              {
                "variable": "APPLICANT_MOBILE",
                "value": { "path": "$.Application[0].applicants[0].mobileNumber" }
              },
              {
                "variable": "APPLICANT_EMAIL",
                "value": { "path": "$.Application[0].applicants[0].emailId" }
              },
              {
                "variable": "ADDRESS_LINE",
                "value": { "path": "$.Application[0].address.addressLine1" }
              },
              {
                "variable": "PINCODE",
                "value": { "path": "$.Application[0].address.pincode" }
              }
            ]
          }
        ]
      }
    ]
  }
}
