{
  "key": "studio-blank-application",
  "documentType": "PUBLICSERVICE",
   "DataConfigs": {
    "serviceName": "public-services",
    "version": "1.0.0",
    "baseKeyPath": "$.Application[*]",
    "entityIdPath": "$.id",
    "mappings": [
      {
        "mappings": [
          {
            "direct": [
              {
                "variable": "APPLICATION_NUMBER",
                "value": { "path": "$.applicationNumber" }
              },
              {
                "variable": "SERVICE_CODE",
                "value": { "path": "$.serviceCode" }
              },
              {
                "variable": "WORKFLOW_STATUS",
                "value": { "path": "$.workflowStatus" }
              },
              {
                "variable": "CREATED_DATE",
                "value": { "path": "$.auditDetails.createdTime" }
              },
              {
                "variable": "APPLICANT_NAME",
                "value": { "path": "$.applicants[0].name" }
              },
              {
                "variable": "APPLICANT_MOBILE",
                "value": { "path": "$.applicants[0].mobileNumber" }
              },
              {
                "variable": "APPLICANT_EMAIL",
                "value": { "path": "$.applicants[0].emailId" }
              },
              {
                "variable": "AGE",
                "value": { "path": "$.serviceDetails.Section2.Age" }
              },
              {
                "variable": "GENDER",
                "value": { "path": "$.serviceDetails.Section2.Gendercheck" }
              },
              {
                "variable": "SECTION_PHONE",
                "value": { "path": "$.serviceDetails.Section2.number" }
              },
              {
                "variable": "ADMIT_DATE",
                "value": { "path": "$.serviceDetails.Section2.Admit" }
              },
              {
                "variable": "ADDRESS_LINE",
                "value": { "path": "$.address.addressLine1" }
              },
              {
                "variable": "PINCODE",
                "value": { "path": "$.address.pincode" }
              },
              {
                "variable": "HAS_APPLICANT",
                "value": { "path": "$.applicants[0].name" }
              },
              {
                "variable": "HAS_SECTION2",
                "value": { "path": "$.serviceDetails.Section2" }
              },
              {
                "variable": "HAS_ADDRESS",
                "value": { "path": "$.address.addressLine1" }
              }
            ]
          }
        ]
      }
    ]
  }
}
