{
  "key": "studio-blank-application",
  "documentType": "PUBLICSERVICE",
 "DataConfigs": {
    "serviceName": "public-services",
    "version": "1.0.0",
    "baseKeyPath": "$.Application[0]",
    "entityIdPath": "$.applicationNumber",
    "mappings": [
      {
        "mappings": [
          {
            "direct": [
              { "variable": "APPLICATION_NUMBER", "value": { "path": "$.applicationNumber" } },
              { "variable": "SERVICE_CODE", "value": { "path": "$.serviceCode" } },
              { "variable": "WORKFLOW_STATUS", "value": { "path": "$.workflowStatus" } },
              { "variable": "CREATED_DATE", "value": { "path": "$.auditDetails.createdTime" } },
              { "variable": "APPLICANT_NAME", "value": { "path": "$.applicants[0].name" } },
              { "variable": "APPLICANT_MOBILE", "value": { "path": "$.applicants[0].mobileNumber" } },
              { "variable": "APPLICANT_EMAIL", "value": { "path": "$.applicants[0].emailId" } },
              { "variable": "ADDRESS_LINE", "value": { "path": "$.address.addressLine1" } },
              { "variable": "PINCODE", "value": { "path": "$.address.pincode" } }
            ]
          }
        ]
      }
    ]
  }
}
