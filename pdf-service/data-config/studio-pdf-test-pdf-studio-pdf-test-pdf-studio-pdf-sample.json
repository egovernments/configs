{
  "DataConfigs": {
    "serviceName": "public-services",
    "version": "1.0.0",
    "baseKeyPath": "$.PublicService.*.Application.*",
    "entityIdPath": "$.id",
    "isCommonTableBorderRequired": true,
    "mappings": [
      {
        "mappings": [
          {
            "direct": [
              {
                "variable": "applicationNumber",
                "value": {
                  "path": "$.applicationNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "applicantName",
                "value": {
                  "path": "$.applicants[0].name"
                },
                "type": "setEmpty"
              },
              {
                "variable": "applicantMobile",
                "value": {
                  "path": "$.applicants[0].mobileNumber"
                },
                "type": "setEmpty"
              },
              {
                "variable": "workflowStatus",
                "value": {
                  "path": "$.workflowStatus"
                },
                "type": "setEmpty",
                "localisation": {
                  "required": true,
                  "prefix": null,
                  "module": "rainmaker-studio"
                }
              },
              {
                "variable": "applicationDate",
                "value": {
                  "path": "$.auditDetails.createdTime"
                },
                "type": "date"
              }
            ]
          },
          {
            "externalAPI": [
              {
                "path": "http://mdms-v2:8080/egov-mdms-service/v1/_get",
                "queryParam": "moduleName=tenant\u0026masterName=tenants\u0026tenantId=$.tenantId\u0026filter=[?(@.code=='{$.tenantId}')]",
                "apiRequest": null,
                "responseMapping": [
                  {
                    "variable": "tenantName",
                    "value": "$.MdmsRes.tenant.tenants[0].name",
                    "localisation": {
                      "required": true,
                      "prefix": null,
                      "module": "rainmaker-studio"
                    }
                  }
                ]
              }
            ]
          },
          {
            "qrcodeConfig": [
              {
                "variable": "qr_code_image",
                "value": "https://unified-dev.digit.org/studio-pdf-helper-service/_scanQR?pdf-id="
              }
            ]
          }
        ]
      }
    ]
  },
  "key": "studio-pdf-test-pdf-studio-pdf-test-pdf-studio-pdf-sample"
}