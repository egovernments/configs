{
  "key": "studio-blank-application",
  "config": {
    "defaultStyle": {
      "font": "Cambay"
    },
    "content": [
      {
        "columns": [
          {
            "width": "70%",
            "stack": [
              { "text": "{{ULB_NAME}}", "style": "headerTitle" },
              { "text": "Department of Records & Verification", "style": "headerSub" },
              {
                "text": "Contact: {{ULB_CONTACT}} | Email: {{ULB_EMAIL}}",
                "style": "headerSub"
              }
            ]
          },
          {
            "width": "30%",
            "stack": [
              { "text": "Application No", "bold": true },
              { "text": "{{APPLICATION_NUMBER}}", "bold": true }
            ],
            "alignment": "right"
          }
        ]
      },

      {
        "style": "sectionBox",
        "table": {
          "widths": ["*", "*"],
          "body": [
            [
              { "text": "Service Code", "bold": true },
              { "text": "{{SERVICE_CODE}}" }
            ],
            [
              { "text": "Submitted On", "bold": true },
              { "text": "{{CREATED_DATE | date:'DD/MM/YYYY'}}" }
            ]
          ]
        }
      },

      {
        "condition": "{{APPLICANT_NAME}}",
        "style": "sectionBox",
        "table": {
          "widths": ["*", "*"],
          "body": [
            [
              { "text": "Applicant Name", "bold": true },
              { "text": "{{APPLICANT_NAME}}" }
            ],
            [
              { "text": "Mobile Number", "bold": true },
              { "text": "{{APPLICANT_MOBILE}}" }
            ],
            [
              { "text": "Email", "bold": true },
              { "text": "{{APPLICANT_EMAIL}}" }
            ]
          ]
        }
      },

      {
        "condition": "{{ADDRESS_LINE}}",
        "style": "sectionBox",
        "table": {
          "widths": ["*", "*"],
          "body": [
            [
              { "text": "Address", "bold": true },
              { "text": "{{ADDRESS_LINE}}" }
            ],
            [
              { "text": "Pincode", "bold": true },
              { "text": "{{PINCODE}}" }
            ]
          ]
        }
      },

      {
        "text": "This is a system generated document. No signature is required.",
        "style": "footerNote",
        "margin": [0, 20, 0, 0]
      }
    ],
    "styles": {
      "headerTitle": { "fontSize": 14, "bold": true },
      "headerSub": { "fontSize": 10, "margin": [0, 2, 0, 6] },
      "sectionBox": { "margin": [0, 10, 0, 0] },
      "footerNote": {
        "fontSize": 9,
        "italics": true,
        "alignment": "center"
      }
    }
  }
}
